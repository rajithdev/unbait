{
  "name": "unbait",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @unbait/server dev",
    "build:extension": "pnpm --filter @unbait/extension build",
    "eval": "tsx evals/run.ts",
    "e2e": "tsx apps/extension/e2e/extension.e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@unbait/core": "workspace:*",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
