# Server configuration. Every value is optional.

# Turns the AI on. Without it the server classifies with rules only.
ANTHROPIC_API_KEY=
# Model used for posts the rules can't decide. Default claude-opus-5-5;
# claude-haiku-5-5 costs about 40x less per token.
UNBAIT_MODEL=claude-opus-5-5
# low | medium | high. Classification works well at low.
UNBAIT_EFFORT=low
# Postgres for the verdict cache, reports and counters. Without it, memory only.
DATABASE_URL=
# Posts per minute per install (and 3x that per IP address).
UNBAIT_POSTS_PER_MINUTE=120
# Posts the AI may classify per UTC day, across all users. A spending cap.
UNBAIT_DAILY_AI_POSTS=5000
PORT=8787
