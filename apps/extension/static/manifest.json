{
  "manifest_version": 3,
  "name": "Unbait",
  "version": "0.0.0",
  "description": "Folds away engagement-bait posts in your LinkedIn feed: comment-to-get giveaways, \"Agree?\" posts, cliffhanger stories and hype lists.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Unbait", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "minimum_chrome_version": "114"
}
